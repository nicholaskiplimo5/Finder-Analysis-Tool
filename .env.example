# Register a free app_id at https://api.deriv.com/ (no auth needed for
# market data, but an app_id is still required).
DERIV_APP_ID=

POSTGRES_USER=finder
POSTGRES_PASSWORD=finder
POSTGRES_DB=finder

DATABASE_URL=postgresql://finder:finder@postgres:5432/finder

# Comma-separated. Defaults to all R_/1HZ*V symbols if unset.
# SYMBOLS=R_10,R_25,R_50,R_75,R_100,1HZ10V,1HZ25V,1HZ50V,1HZ75V,1HZ100V

# Comma-separated origins allowed to call the API (module 3). Defaults to
# localhost:5173/3000 (typical Vite/CRA dev servers) if unset.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
